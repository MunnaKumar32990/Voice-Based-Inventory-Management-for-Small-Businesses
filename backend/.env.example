# Database (Local: mongodb://localhost:27017 | Cloud: mongodb+srv://admin:pass@cluster.mongodb.net/?retryWrites=true&w=majority)
MONGODB_URI=mongodb://localhost:27017
DB_NAME=voice_inventory

# Security (JWT)
JWT_SECRET=voicestock-dev-secret-key-change-in-production-2024
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS (Use * in cloud or your frontend URL)
CORS_ORIGINS=["*"]

# Speech Provider (webspeech=free browser speech, sarvam=Sarvam AI, azure=Azure AI Speech)
SPEECH_PROVIDER=webspeech
MAX_AUDIO_MB=10

# Optional Azure AI Speech (only if SPEECH_PROVIDER=azure)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Gemini LLM Fallback (Conversational DB intelligence)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
