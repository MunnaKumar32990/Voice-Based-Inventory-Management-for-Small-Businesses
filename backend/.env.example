MONGODB_URI=mongodb://localhost:27017
DB_NAME=voice_inventory
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Speech-to-text. Default works with ZERO keys (browser Web Speech API).
# Only set these if you want server-side transcription of raw audio.
SPEECH_PROVIDER=webspeech
# SARVAM_API_KEY=your_sarvam_key_here
# GOOGLE_SPEECH_API_KEY=your_google_key_here

# Azure AI Speech (your keys): use Key1 or Key2 + region uaenorth.
# SPEECH_PROVIDER=azure
# AZURE_SPEECH_KEY=paste_Key1_or_Key2_here
# AZURE_SPEECH_REGION=uaenorth
MAX_AUDIO_MB=10
