# Backend host. The app appends /api/v1 automatically, so both forms work:
#   http://localhost:8000   (recommended)
#   http://localhost:8000/api/v1
VITE_API_URL=http://localhost:8000

# Mic path: webspeech (default, free browser speech) or azure
# (record audio -> POST /voice/transcribe with your Azure keys on the backend).
# VITE_SPEECH_PROVIDER=webspeech
