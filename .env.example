# Root env — copy values into backend/.env and frontend/.env.
# The app runs with ZERO keys (browser speech + demo login).
# Only fill keys below to enable server-side speech providers.

# Backend (backend/.env)
MONGODB_URI=mongodb://localhost:27017
DB_NAME=voice_inventory
JWT_SECRET=change_me_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SPEECH_PROVIDER=webspeech
# SARVAM_API_KEY=
# GOOGLE_SPEECH_API_KEY=
# Azure AI Speech (region uaenorth): paste Key1 or Key2 from Azure portal.
# SPEECH_PROVIDER=azure
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=uaenorth
MAX_AUDIO_MB=10

# Frontend (frontend/.env)
# VITE_API_URL=http://localhost:8000
# Use Azure mic path (record -> POST /voice/transcribe) instead of browser speech:
# VITE_SPEECH_PROVIDER=webspeech  (default) | azure
